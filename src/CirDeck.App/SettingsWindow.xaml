<Window x:Class="CirDeck.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="设置"
        Width="1040"
        Height="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="#3A3A3C" CornerRadius="15">
                            <Border x:Name="Thumb" Width="26" Height="26" Background="White" CornerRadius="13" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0A84FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D1D6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2C2C30"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="6,2,0,10"/>
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="#FF453A"/>
            <Setter Property="Background" Value="#3A2222"/>
        </Style>
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MaxHeight" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Height="34">
                            <ToggleButton Style="{x:Null}" Height="34" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#3A3A3C" CornerRadius="8"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#C7C7CC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <ContentPresenter x:Name="ContentSite" Margin="12,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#2C2C30" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,6,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="MaxHeight" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="#0A84FF" CornerRadius="2" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="#3A3A3C" CornerRadius="2" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{x:Null}" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="16" Height="16" Background="White" CornerRadius="8" BorderBrush="#14000000" BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="18" Background="#1C1C1E" CornerRadius="18" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#232326" CornerRadius="18,0,0,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,18">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#0A84FF">
                            <TextBlock Text="C" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CirDeck" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="开源免费" Foreground="#8E8E93" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Ellipse DockPanel.Dock="Bottom" Width="8" Height="8" Fill="#30D158" HorizontalAlignment="Left" Margin="22,0,0,20"/>
                    <StackPanel Margin="0,4,0,0">
                        <Button x:Name="NavGeneral" Tag="通用" Style="{StaticResource NavButton}" Click="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="通用" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDock" Tag="程序坞" Style="{StaticResource NavButton}" Click="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="程序坞" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLook" Tag="外观与图标" Style="{StaticResource NavButton}" Click="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="外观与图标" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLayout" Tag="布局与网格" Style="{StaticResource NavButton}" Click="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="布局与网格" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavWidgets" Tag="小组件" Style="{StaticResource NavButton}" Click="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE917;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="小组件" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavMotion" Tag="动效与手势" Style="{StaticResource NavButton}" Click="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE815;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="动效与手势" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavApps" Tag="应用管理" Style="{StaticResource NavButton}" Click="OnNav">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="22" VerticalAlignment="Center"/>
                                <TextBlock Text="应用管理" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="28,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" MinHeight="72" Margin="0,0,0,12">
                    <StackPanel Margin="36,4,36,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="通用" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="PageSubtitle" Text="开机自启、全局快捷键、多显示器行为与检查更新" FontSize="13" Foreground="#8E8E93" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Cursor="Hand" Click="OnClose" Foreground="#A1A1A6" FontFamily="Segoe MDL2 Assets" Content="&#xE8BB;" FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,8">
                    <StackPanel>
                        <StackPanel x:Name="PageGeneral">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="开机自启动" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="StartupBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="68">
                                        <StackPanel VerticalAlignment="Center" Margin="18,10,70,10">
                                            <TextBlock Text="自启动后打开启动台" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="关闭时仅在后台运行" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="OpenAtStartupBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                                            <TextBlock Text="全局快捷键" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8E8E93" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="用来打开或收起启动台"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#3A3A3C" CornerRadius="8" Padding="12,6" Margin="0,0,16,0">
                                            <TextBlock Text="Ctrl + Alt + Space" Foreground="#F5F5F7" FontSize="13"/>
                                        </Border>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="打开应用后自动收起" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="CloseAfterBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,12,0">
                                            <TextBlock Text="启动台显示屏幕" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8E8E93" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="启动台出现在哪一块屏幕上"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}" x:Name="ScreenCombo" Width="196" Margin="0,0,16,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="桌面常驻与临时置顶" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <Grid MinHeight="78">
                                    <StackPanel VerticalAlignment="Center" Margin="18,12,80,12">
                                        <TextBlock Text="在桌面常驻启动台" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="显示在桌面上、应用窗口后面；启动应用后不收起。关闭可恢复原有行为。" Style="{StaticResource RowNote}"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="DesktopBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="68">
                                        <StackPanel VerticalAlignment="Center" Margin="18,10,120,10">
                                            <TextBlock x:Name="VersionText" Text="当前版本 1.0.0" Style="{StaticResource RowTitle}"/>
                                            <TextBlock x:Name="CheckText" Text="尚未检查更新" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <Button Content="检查更新" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,0,16,0" Click="OnCheckUpdate"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="自动检查更新" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="AutoUpdateBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,12,0">
                                            <TextBlock Text="恢复默认设置" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#8E8E93" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="只恢复开关和屏幕选项，不删除图标和布局"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="恢复默认" Style="{StaticResource DangerButton}" Margin="0,0,16,0" Click="OnReset"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PageDock" Visibility="Collapsed">
                            <TextBlock TextWrapping="Wrap" Foreground="#C7C7CC" FontSize="13" Margin="6,0,6,14" Text="Dock 用来快速打开固定应用，也可以在右侧显示正在运行的窗口。系统托盘图标仍由 Windows 自己托管。"/>
                            <TextBlock Text="桌面 Dock" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="64">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,70,8">
                                            <TextBlock Text="显示程序坞" Style="{StaticResource RowTitle}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ShowDockBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="68">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,70,8">
                                            <TextBlock Text="在桌面常驻 Dock" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="快速启动固定应用，打开其他窗口时可以被盖住" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="ResidentBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="68">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,70,8">
                                            <TextBlock Text="Dock 右侧显示打开的应用" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="包括最小化窗口。同一应用只显示一个，点击恢复，悬停预览，关闭后移除" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="RunningAppsBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="68">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,70,8">
                                            <TextBlock Text="合并固定图标与运行中的应用" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="已固定的应用不在右侧再出现一次，点固定图标即可恢复窗口" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="MergeBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="64">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,70,8">
                                            <TextBlock Text="Dock 时间与日期" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="显示在最右侧，使用系统本地时间" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="DockClockBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="64">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,70,8">
                                            <TextBlock Text="显示回收站" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="点击打开，拖入文件回收，右键清空" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="RecycleBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="Dock 背景" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ComboBox Style="{StaticResource DarkCombo}" x:Name="MaterialCombo" Width="140" Margin="0,0,16,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="72">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,16,8">
                                            <DockPanel>
                                                <TextBlock x:Name="BottomText" DockPanel.Dock="Right" Text="8 pt" Foreground="#D1D1D6" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <TextBlock Text="桌面 Dock 离底部高度" Style="{StaticResource RowTitle}"/>
                                            </DockPanel>
                                            <Slider x:Name="BottomSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="OnDockMetric"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="68">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,70,8">
                                            <TextBlock Text="隐藏系统任务栏" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="关闭开关或退出 CirDeck 后会恢复系统任务栏" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="HideTaskbarBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="触发角" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="打开启动台" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <ComboBox Style="{StaticResource DarkCombo}" x:Name="LaunchCornerCombo" Width="110" Margin="0,0,12,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                            <ToggleButton x:Name="LaunchCornerBox" Style="{StaticResource ToggleButtonSwitch}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="打开桌面 Dock" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <ComboBox Style="{StaticResource DarkCombo}" x:Name="DockCornerCombo" Width="110" Margin="0,0,12,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                            <ToggleButton x:Name="DockCornerBox" Style="{StaticResource ToggleButtonSwitch}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="64">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,70,8">
                                            <TextBlock Text="全屏时暂停触发角" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="两个功能不要用同一个角。唤出的 Dock 浮在窗口上方，鼠标离开后按常驻设置收回" Style="{StaticResource RowNote}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="FullscreenPauseBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="图标外观" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="64">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,16,8">
                                            <DockPanel>
                                                <TextBlock x:Name="IconSizeText" DockPanel.Dock="Right" Text="56 pt" Foreground="#D1D1D6" VerticalAlignment="Center"/>
                                                <TextBlock Text="图标大小" Style="{StaticResource RowTitle}"/>
                                            </DockPanel>
                                            <Slider x:Name="IconSizeSlider" Minimum="32" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="OnDockMetric"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="64">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,16,8">
                                            <DockPanel>
                                                <TextBlock x:Name="GapText" DockPanel.Dock="Right" Text="15 pt" Foreground="#D1D1D6" VerticalAlignment="Center"/>
                                                <TextBlock Text="图标间距" Style="{StaticResource RowTitle}"/>
                                            </DockPanel>
                                            <Slider x:Name="GapSlider" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="OnDockMetric"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="悬停放大" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="MagnifyBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="64">
                                        <StackPanel VerticalAlignment="Center" Margin="18,8,16,8">
                                            <DockPanel>
                                                <TextBlock x:Name="GrowText" DockPanel.Dock="Right" Text="1.75x" Foreground="#D1D1D6" VerticalAlignment="Center"/>
                                                <TextBlock Text="放大倍数" Style="{StaticResource RowTitle}"/>
                                            </DockPanel>
                                            <Slider x:Name="GrowSlider" Minimum="1" Maximum="2.2" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="OnDockMetric"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="启动弹跳" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="BounceBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="显示运行指示点" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="RunningBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="把应用拖到启动台里固定，或在 Dock 图标上右键固定。" Foreground="#8E8E93" FontSize="12" Margin="6,4,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="PageLook" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="图标形状" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ComboBox Style="{StaticResource DarkCombo}" x:Name="ShapeCombo" Width="140" Margin="0,0,16,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="64">
                                        <StackPanel Margin="18,8">
                                            <TextBlock Text="图标大小" Style="{StaticResource RowTitle}"/>
                                            <Slider x:Name="IconScaleSlider" Minimum="70" Maximum="140" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,8,0,0" ValueChanged="OnDockMetric"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="显示应用名称" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="ShowNamesBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="名称字号" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Slider x:Name="NameSizeSlider" Width="180" Minimum="9" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" Margin="0,0,16,0" ValueChanged="OnDockMetric"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="名称颜色" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ComboBox Style="{StaticResource DarkCombo}" x:Name="NameColorCombo" Width="120" Margin="0,0,16,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="名称文字阴影" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="NameShadowBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="壁纸模糊" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Slider x:Name="BlurSlider" Width="180" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" Margin="0,0,16,0" ValueChanged="OnDockMetric"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="遮罩浓度" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Slider x:Name="VeilSlider" Width="180" Minimum="0" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" Margin="0,0,16,0" ValueChanged="OnDockMetric"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="背景使用当前桌面壁纸。主题图片包不做。" Foreground="#8E8E93" FontSize="12" Margin="6,0,0,8"/>
                        </StackPanel>
                        <StackPanel x:Name="PageLayout" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="锁定图标" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="LockBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="每页列数 / 行数" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                                            <ComboBox Style="{StaticResource DarkCombo}" x:Name="ColumnsCombo" Width="72" Margin="0,0,8,0"/>
                                            <ComboBox Style="{StaticResource DarkCombo}" x:Name="RowsCombo" Width="72"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="页面左右边距" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Slider x:Name="PageXSlider" Width="180" Minimum="0" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" Margin="0,0,16,0" ValueChanged="OnDockMetric"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="页面上下边距" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Slider x:Name="PageYSlider" Width="180" Minimum="0" Maximum="160" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" Margin="0,0,16,0" ValueChanged="OnDockMetric"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="内容左右留白" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Slider x:Name="ContentXSlider" Width="180" Minimum="0" Maximum="280" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" Margin="0,0,16,0" ValueChanged="OnDockMetric"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="内容顶部留白" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Slider x:Name="ContentTopSlider" Width="180" Minimum="0" Maximum="160" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" Margin="0,0,16,0" ValueChanged="OnDockMetric"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="64">
                                        <TextBlock Text="当前布局" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ComboBox Style="{StaticResource DarkCombo}" x:Name="LayoutCombo" Width="180" Margin="0,0,16,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Button Content="切换" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="OnSwitchLayout"/>
                                <Button Content="另存" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="OnSaveLayout"/>
                                <Button Content="导出" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="OnExport"/>
                                <Button Content="导入" Style="{StaticResource QuietButton}" Click="OnImport"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="时钟" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="ClockBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="CPU 和内存" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="MonitorBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="音乐频谱" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="MusicBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="扫描 Steam 游戏" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="SteamBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="显示秒数" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="SecondsBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="大时钟显示日期" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="DateBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="时钟透明背景" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="ClockClearBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="时钟字号" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Slider x:Name="ClockSizeSlider" Width="180" Minimum="36" Maximum="72" TickFrequency="1" IsSnapToTickEnabled="True" HorizontalAlignment="Right" Margin="0,0,16,0" ValueChanged="OnDockMetric"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="鼠标移到顶部显示搜索" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="TopSearchBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="隐藏设置按钮" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="HideGearBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PageMotion" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <Grid MinHeight="68">
                                    <StackPanel VerticalAlignment="Center" Margin="18,12,200,12">
                                        <TextBlock Text="屏幕热角唤出启动台" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="鼠标停在所选角落片刻后打开" Style="{StaticResource RowNote}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ComboBox Style="{StaticResource DarkCombo}" x:Name="CornerCombo" Width="120" Margin="0,0,12,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                        <ToggleButton x:Name="CornerBox" Style="{StaticResource ToggleButtonSwitch}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="翻页速度" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ComboBox Style="{StaticResource DarkCombo}" x:Name="SpeedCombo" Width="120" Margin="0,0,16,0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="短距离滑动回弹" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="ShortBounceBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="点击弹性" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="ClickBounceBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="悬停倾斜" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="HoverTiltBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="前台全屏游戏时暂停触发角" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <ToggleButton x:Name="GamePauseBox" Style="{StaticResource ToggleButtonSwitch}" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PageApps" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="收纳桌面快捷方式" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Button Content="收纳应用" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,0,16,0" Click="OnCollectApps"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="收纳桌面文件" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Button Content="收纳文件" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,0,16,0" Click="OnCollectFiles"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="还原到桌面" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Button Content="还原" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,0,16,0" Click="OnRestoreDesktop"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="手动添加程序" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Button Content="选择程序" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,0,16,0" Click="OnAddProgram"/>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="重置应用数据库" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Button Content="重置" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Margin="0,0,16,0" Click="OnResetLibrary"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="导出 / 导入设置" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                                            <Button Content="导出" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="OnExportSettings"/>
                                            <Button Content="导入" Style="{StaticResource QuietButton}" Click="OnImportSettings"/>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#14FFFFFF" Margin="16,0"/>
                                    <Grid MinHeight="58">
                                        <TextBlock Text="保存当前桌面" Style="{StaticResource RowTitle}" Margin="18,0"/>
                                        <Button Content="保存快照" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Margin="0,0,16,0" Click="OnSaveSnapshot"/>
                                    </Grid>
                                    <ListBox x:Name="SnapshotList" Height="120" Margin="12,0,12,8" Background="Transparent" Foreground="White" BorderThickness="0"/>
                                    <Button Content="恢复选中快照" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="12,0,0,12" Click="OnRestoreSnapshot"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="已隐藏的应用" Style="{StaticResource Section}"/>
                            <Border Style="{StaticResource Card}" Padding="6">
                                <ListBox x:Name="HiddenList" Height="280" Background="Transparent" Foreground="#F5F5F7" BorderThickness="0">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="12,8"/>
                                            <Setter Property="Foreground" Value="#F5F5F7"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="8">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                            <Button Content="恢复选中" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="OnUnhide"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
