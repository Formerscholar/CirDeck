<Window x:Class="CirDeck.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="980"
        Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="Track" Background="#5C5C60" CornerRadius="14"/>
                            <Border x:Name="Thumb" Width="22" Height="22" Background="White" CornerRadius="11" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2F80FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2F2F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Background" Value="#332C2C2E"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Border Background="#F01E1E22" CornerRadius="22" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#14FFFFFF" CornerRadius="22,0,0,22">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,22,16,18">
                        <TextBlock Text="CirDeck" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="开源免费" FontSize="12" Foreground="#A1A1A6" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="22,0,0,18">
                        <Ellipse Width="8" Height="8" Fill="#30D158" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SavedText" Text="已自动保存" Foreground="#A1A1A6" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <Button x:Name="NavGeneral" Style="{StaticResource NavButton}" Content="通用" Click="OnNav"/>
                        <Button x:Name="NavDock" Style="{StaticResource NavButton}" Content="程序坞" Click="OnNav"/>
                        <Button x:Name="NavLayout" Style="{StaticResource NavButton}" Content="布局与网格" Click="OnNav"/>
                        <Button x:Name="NavWidgets" Style="{StaticResource NavButton}" Content="小组件" Click="OnNav"/>
                        <Button x:Name="NavMotion" Style="{StaticResource NavButton}" Content="动效与手势" Click="OnNav"/>
                        <Button x:Name="NavApps" Style="{StaticResource NavButton}" Content="应用管理" Click="OnNav"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="28,18,22,18">
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="#C7C7CC" BorderThickness="0" Click="OnClose"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="通用" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PageSubtitle" Text="开机自启、全局快捷键、多显示器行为" FontSize="12" Foreground="#A1A1A6" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                        <StackPanel x:Name="PageGeneral">
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="开机自启动" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="OpenAtStartupBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <StackPanel>
                                        <TextBlock Text="自启动时打开启动台" Foreground="White" FontSize="15"/>
                                        <TextBlock Text="关闭时仅在后台运行" Foreground="#8E8E93" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <Border DockPanel.Dock="Right" Background="#3A3A3C" CornerRadius="8" Padding="10,6">
                                        <TextBlock Text="Ctrl + Alt + Space" Foreground="White" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="全局快捷键" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="CloseAfterBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="打开应用后自动收起" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <Button Content="恢复默认" DockPanel.Dock="Right" Background="#3A1C1C" Foreground="#FF453A" BorderThickness="0" Padding="12,6" Click="OnReset">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Text="恢复默认设置" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PageDock" Visibility="Collapsed">
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="ShowDockBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="显示程序坞" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="MagnifyBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="鼠标靠近时放大" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="RunningBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="显示正在运行的圆点" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PageLayout" Visibility="Collapsed">
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <ComboBox x:Name="LayoutCombo" DockPanel.Dock="Right" Width="180"/>
                                    <TextBlock Text="当前布局" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                <Button Content="切换" Width="72" Margin="0,0,8,0" Click="OnSwitchLayout"/>
                                <Button Content="另存" Width="72" Margin="0,0,8,0" Click="OnSaveLayout"/>
                                <Button Content="导出" Width="72" Margin="0,0,8,0" Click="OnExport"/>
                                <Button Content="导入" Width="72" Click="OnImport"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="ClockBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="时钟" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="MonitorBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="CPU 和内存" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="MusicBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="音乐频谱" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="SteamBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <TextBlock Text="扫描 Steam 游戏" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PageMotion" Visibility="Collapsed">
                            <Border Style="{StaticResource RowCard}">
                                <DockPanel Margin="0,8">
                                    <CheckBox x:Name="CornerBox" Style="{StaticResource Switch}" DockPanel.Dock="Right"/>
                                    <StackPanel>
                                        <TextBlock Text="屏幕热角唤出启动台" Foreground="White" FontSize="15"/>
                                        <ComboBox x:Name="CornerCombo" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="PageApps" Visibility="Collapsed">
                            <TextBlock Text="已隐藏的应用" Foreground="#A1A1A6" Margin="4,0,0,8"/>
                            <ListBox x:Name="HiddenList" Height="280" Background="#332C2C2E" Foreground="White" BorderThickness="0"/>
                            <Button Content="恢复选中" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="12,6" Click="OnUnhide"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
