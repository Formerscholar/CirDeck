<Window x:Class="CirDeck.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CirDeck 设置"
        Width="420"
        Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1C1C1E"
        Foreground="#F5F5F7"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Topmost="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="常规" FontSize="13" Foreground="#A1A1A6" Margin="0,0,0,8"/>
            <CheckBox x:Name="StartupBox" Content="开机启动" Margin="0,4" Foreground="#F5F5F7"/>
            <CheckBox x:Name="CornerBox" Content="屏幕热角唤出启动台" Margin="0,4" Foreground="#F5F5F7"/>
            <ComboBox x:Name="CornerCombo" Margin="0,4,0,12"/>
            <TextBlock Text="小组件" FontSize="13" Foreground="#A1A1A6" Margin="0,8,0,8"/>
            <CheckBox x:Name="ClockBox" Content="时钟" Margin="0,4" Foreground="#F5F5F7"/>
            <CheckBox x:Name="MonitorBox" Content="CPU 和内存" Margin="0,4" Foreground="#F5F5F7"/>
            <CheckBox x:Name="MusicBox" Content="音乐频谱" Margin="0,4" Foreground="#F5F5F7"/>
            <CheckBox x:Name="SteamBox" Content="扫描 Steam 游戏" Margin="0,4,0,12" Foreground="#F5F5F7"/>
            <TextBlock Text="布局" FontSize="13" Foreground="#A1A1A6" Margin="0,8,0,8"/>
            <ComboBox x:Name="LayoutCombo" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="切换" Width="72" Margin="0,0,8,0" Click="OnSwitchLayout"/>
                <Button Content="另存" Width="72" Margin="0,0,8,0" Click="OnSaveLayout"/>
                <Button Content="导出" Width="72" Margin="0,0,8,0" Click="OnExport"/>
                <Button Content="导入" Width="72" Click="OnImport"/>
            </StackPanel>
            <TextBlock Text="已隐藏" FontSize="13" Foreground="#A1A1A6" Margin="0,8,0,8"/>
            <ListBox x:Name="HiddenList" Height="140" Background="#2C2C2E" Foreground="#F5F5F7" BorderThickness="0"/>
            <Button Content="恢复选中" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnUnhide"/>
        </StackPanel>
    </ScrollViewer>
</Window>
