<Window x:Class="CirDeck.App.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        Deactivated="OnDeactivated">
    <Window.Resources>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Background="#E5E5EA" CornerRadius="14">
                            <Border x:Name="Thumb" Width="24" Height="24" Background="White" CornerRadius="12" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0A84FF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="16" Background="#F7F7F8" CornerRadius="18" Padding="16,14,16,16" Width="292">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="2,0,2,10">
                <Button DockPanel.Dock="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" Click="OnRefresh" ToolTip="刷新">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="应用托盘" FontSize="16" FontWeight="SemiBold" Foreground="#1C1C1E" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="EmptyText" Text="没有读到托盘图标" Foreground="#8E8E93" FontSize="12" Margin="4,8,4,12" Visibility="Collapsed"/>
            <UniformGrid x:Name="Icons" Columns="5" Margin="0,0,0,8"/>
            <Border Height="1" Background="#E5E5EA" Margin="0,6,0,12"/>
            <DockPanel Margin="2,0,2,8">
                <Button DockPanel.Dock="Right" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Focusable="False" Click="OnPower" ToolTip="电源">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="系统控制" FontSize="16" FontWeight="SemiBold" Foreground="#1C1C1E" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="2,6,2,10">
                <CheckBox x:Name="TaskbarBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="OnTaskbar" Unchecked="OnTaskbar"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#3A3A3C" VerticalAlignment="Center"/>
                    <TextBlock Text="隐藏系统任务栏" FontSize="14" Foreground="#1C1C1E" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="2,4,2,8">
                <Button x:Name="InputButton" MinWidth="36" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="16" FontWeight="SemiBold" Foreground="#1C1C1E" Click="OnInput" Content="中"/>
                <Button x:Name="NetButton" Width="36" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnNetwork" Margin="8,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            <DockPanel Margin="2,2,2,0">
                <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Text="0%" Foreground="#8E8E93" FontSize="13" VerticalAlignment="Center" MinWidth="42" TextAlignment="Right"/>
                <Button x:Name="MuteButton" DockPanel.Dock="Left" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnMute" Margin="0,0,6,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="OnVolume"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
