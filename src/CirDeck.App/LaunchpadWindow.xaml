<Window x:Class="CirDeck.App.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CirDeck"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F3E6D8"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnMouseWheel"
        PreviewMouseLeftButtonUp="OnTileUp">
    <Grid>
        <Image x:Name="Backdrop" Stretch="UniformToFill" IsHitTestVisible="False"/>
        <Border Background="#14000000" IsHitTestVisible="False"/>
        <Grid Margin="0,0,0,96">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>
            <Grid Margin="28,18,28,0">
                <Border x:Name="MonitorPill" HorizontalAlignment="Center" Background="#8C1C1C1E" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CPU" Foreground="#F5F5F7" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CpuText" Text="0%" Foreground="#F5F5F7" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RAM" Foreground="#F5F5F7" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RamText" Text="0%" Foreground="#F5F5F7" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border HorizontalAlignment="Right" Background="#8C1C1C1E" CornerRadius="18" Height="36" VerticalAlignment="Center">
                    <DockPanel>
                        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="34" Background="Transparent" Foreground="#F5F5F7" BorderThickness="0" Click="OnOpenSettings"/>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl + Alt + Space" Foreground="#B3F5F5F7" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Grid Width="280">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="OnSearchChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#E6FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Text="搜索应用名称或拼音首字母" Foreground="#C7F5F5F7" FontSize="12" VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="FolderTitle" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="16" Visibility="Collapsed"/>
            </Grid>
            <StackPanel x:Name="ClockPanel" Grid.Row="1" HorizontalAlignment="Center" Margin="0,18,0,8">
                <TextBlock x:Name="DateText" TextAlignment="Center" Foreground="White" FontSize="16" Margin="0,0,0,12">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="Black" Opacity="0.35"/>
                    </TextBlock.Effect>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#F0141418" CornerRadius="14" Width="112" Height="96">
                        <TextBlock x:Name="HourText" FontSize="58" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text=":" FontSize="42" FontWeight="Bold" Foreground="White" Margin="12,0" VerticalAlignment="Center"/>
                    <Border Background="#F0141418" CornerRadius="14" Width="112" Height="96">
                        <TextBlock x:Name="MinuteText" FontSize="58" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text=":" FontSize="42" FontWeight="Bold" Foreground="White" Margin="12,0" VerticalAlignment="Center"/>
                    <Border Background="#F0141418" CornerRadius="14" Width="112" Height="96">
                        <TextBlock x:Name="SecondText" FontSize="58" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="Spectrum" Orientation="Horizontal" HorizontalAlignment="Center" Height="18" Margin="0,10,0,0"/>
            </StackPanel>
            <Grid Grid.Row="2">
                <TextBlock x:Name="EmptyText" Text="正在读取开始菜单…" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ItemsControl x:Name="Tiles" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Width="104" Click="OnTileClick" PreviewMouseRightButtonUp="OnTileMenu" PreviewMouseLeftButtonDown="OnTileDown" PreviewMouseMove="OnTileMove">
                                <StackPanel>
                                    <Image Width="54" Height="54" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.22" Color="Black"/>
                                        </Image.Effect>
                                    </Image>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="96" Margin="0,6,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="Black" Opacity="0.55"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <StackPanel x:Name="Dots" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
