<Window x:Class="CirDeck.App.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CirDeck"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnMouseWheel"
        PreviewMouseLeftButtonUp="OnTileUp">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#CC141821" Offset="0"/>
                <GradientStop Color="#B31A2030" Offset="0.55"/>
                <GradientStop Color="#CC10141C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Ellipse Width="560" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-40,-40,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#227AA2FF" Offset="0"/>
                    <GradientStop Color="#007AA2FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="520" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-20,-40" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#20C9A0FF" Offset="0"/>
                    <GradientStop Color="#00C9A0FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="108"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,18,0,0">
                <TextBlock x:Name="ClockText" FontSize="32" FontWeight="Light" Foreground="#F5F5F7"/>
                <TextBlock x:Name="MonitorText" FontSize="12" Foreground="#C7C7CC" Margin="0,2,0,0"/>
                <StackPanel x:Name="Spectrum" Orientation="Horizontal" Height="22" Margin="0,8,0,0"/>
            </StackPanel>
            <Button x:Name="SettingsButton" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,24,0" Background="#22FFFFFF" Foreground="#F5F5F7" BorderThickness="0" Click="OnOpenSettings"/>
            <TextBlock x:Name="FolderTitle" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0" Foreground="#F5F5F7" FontSize="16" Visibility="Collapsed"/>
            <Grid Width="380" Height="40" VerticalAlignment="Bottom" Margin="0,0,0,18">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="OnSearchChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#E6FFFFFF" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="搜索" Foreground="#B3F5F5F7" FontSize="15" VerticalAlignment="Center" Margin="40,0,0,0" IsHitTestVisible="False"/>
            </Grid>
            <Grid Grid.Row="1">
                <TextBlock x:Name="EmptyText" Text="正在读取开始菜单…" Foreground="#F5F5F7" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ItemsControl x:Name="Tiles" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" Width="112" Click="OnTileClick" PreviewMouseRightButtonUp="OnTileMenu" PreviewMouseLeftButtonDown="OnTileDown" PreviewMouseMove="OnTileMove">
                                <StackPanel>
                                    <Image Width="72" Height="72" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.28" Color="Black"/>
                                        </Image.Effect>
                                    </Image>
                                    <TextBlock Text="{Binding Name}" Foreground="#F5F5F7" FontSize="12" FontWeight="Medium" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="104" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
