<Window x:Class="CirDeck.App.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CirDeck"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F3E6D8"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnMouseWheel"
        PreviewMouseLeftButtonDown="OnPointerDown"
        PreviewMouseMove="OnPointerMove"
        PreviewMouseLeftButtonUp="OnTileUp">
    <Grid>
        <Image x:Name="Backdrop" Stretch="UniformToFill" IsHitTestVisible="False"/>
        <Rectangle x:Name="Veil" Fill="#F6F3EE" Opacity="0" IsHitTestVisible="False"/>
        <Grid Margin="28,18,28,0" VerticalAlignment="Top">
                <Border x:Name="MonitorPill" HorizontalAlignment="Center" Background="#8C1C1C1E" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="16" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F5F5F7" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU" Foreground="#F5F5F7" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CpuText" Text="0%" Foreground="#F5F5F7" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE964;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F5F5F7" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RAM" Foreground="#F5F5F7" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="RamText" Text="0%" Foreground="#F5F5F7" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SearchChrome" HorizontalAlignment="Right" Background="#8C1C1C1E" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="17" Height="36" Padding="12,0,4,0" VerticalAlignment="Center">
                    <DockPanel>
                        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="32" Height="32" Background="Transparent" Foreground="#F5F5F7" BorderThickness="0" Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}" PreviewMouseLeftButtonUp="OnOpenSettings">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl + Alt + Space" Foreground="#99F5F5F7" FontSize="11" VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <Grid Width="250">
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="OnSearchChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#E6FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Text="搜索应用名称或拼音首字母" Foreground="#B3F5F5F7" FontSize="12" VerticalAlignment="Center" Margin="24,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="FolderTitle" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="16" Visibility="Collapsed"/>
        </Grid>
        <Grid x:Name="Stage" VerticalAlignment="Center" Margin="0,52,0,108">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="ClockPanel" HorizontalAlignment="Center" Margin="0,0,0,28">
                <TextBlock x:Name="DateText" TextAlignment="Center" Foreground="#E6FFFFFF" FontSize="15" FontWeight="Normal" Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border x:Name="HourCard" Background="#F0141418" CornerRadius="14" Width="112" Height="96">
                        <TextBlock x:Name="HourText" FontSize="58" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="·" FontSize="16" Foreground="#99FFFFFF" Margin="14,0" VerticalAlignment="Center"/>
                    <Border x:Name="MinuteCard" Background="#F0141418" CornerRadius="14" Width="112" Height="96">
                        <TextBlock x:Name="MinuteText" FontSize="58" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="·" FontSize="16" Foreground="#99FFFFFF" Margin="14,0" VerticalAlignment="Center"/>
                    <Border x:Name="SecondCard" Background="#F0141418" CornerRadius="14" Width="112" Height="96">
                        <TextBlock x:Name="SecondText" FontSize="58" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="Spectrum" Orientation="Horizontal" HorizontalAlignment="Center" Height="18" Margin="0,10,0,0"/>
            </StackPanel>
            <Grid x:Name="PageHost" Grid.Row="1" ClipToBounds="True">
                <TextBlock x:Name="EmptyText" Text="正在读取开始菜单…" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ItemsControl x:Name="Tiles" HorizontalAlignment="Center" VerticalAlignment="Top" BorderThickness="0" Background="Transparent">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ItemsPresenter VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" VerticalAlignment="Top" HorizontalAlignment="Center" Click="OnTileClick" PreviewMouseRightButtonUp="OnTileMenu" PreviewMouseLeftButtonDown="OnTileDown" PreviewMouseMove="OnTileMove" Loaded="OnTileLoaded" MouseEnter="OnTileEnter" MouseLeave="OnTileLeave">
                                <StackPanel>
                                    <Border x:Name="Well" Width="68" Height="68" CornerRadius="18" Background="#2AFFFFFF" HorizontalAlignment="Center">
                                        <Image Width="42" Height="42" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Foreground="#EEFFFFFF" FontSize="12" FontWeight="Normal" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="108" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0"/>
        </Grid>
    </Grid>
</Window>
