<Window x:Class="CirDeck.App.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CirDeck"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#121418"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnPreviewKeyDown"
        MouseWheel="OnMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="128"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,18">
            <TextBlock Text="CirDeck" Foreground="#A39E93" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="520" TextChanged="OnSearchChanged"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyText" Text="正在读取开始菜单…" Foreground="#A39E93" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ItemsControl x:Name="Tiles" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Width="124" Click="OnTileClick" PreviewMouseRightButtonUp="OnTileMenu">
                            <StackPanel>
                                <Image Width="56" Height="56" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" Foreground="#F4F1EA" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="108" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Foreground="#A39E93" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
