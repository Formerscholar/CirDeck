<Window x:Class="CirDeck.App.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CirDeck Dock"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        MouseMove="OnMouseMove"
        MouseLeave="OnMouseLeave"
        MouseLeftButtonUp="OnMouseUp"
        MouseRightButtonUp="OnBackgroundMenu">
    <Grid>
        <Border x:Name="Plate" VerticalAlignment="Bottom" Background="#2EFFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False"/>
        <Canvas x:Name="Surface"/>
    </Grid>
</Window>
